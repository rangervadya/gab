      {
        "id": "GAB2000000000012",
        "name": "Parse PDF records",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2420,
          100
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "\nconst outputs = $input.all();\nconst pages = $(\"Prepare PDF pages\").all();\n\nif (outputs.length !== pages.length) {\n  throw new Error(\n    \"Не все страницы обработаны Ollama: \" +\n    outputs.length + \" из \" + pages.length\n  );\n}\n\nfunction normalizeRevenue(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return null;\n  }\n\n  if (typeof value === \"number\" && Number.isFinite(value)) {\n    return value;\n  }\n\n  let s = String(value)\n    .replace(/\\u00a0/g, \" \")\n    .replace(/руб\\.?|₽/gi, \"\")\n    .replace(/\\s/g, \"\")\n    .trim();\n\n  if (s.includes(\",\") && s.includes(\".\")) {\n    if (s.lastIndexOf(\",\") > s.lastIndexOf(\".\")) {\n      s = s.replace(/\\./g, \"\").replace(\",\", \".\");\n    } else {\n      s = s.replace(/,/g, \"\");\n    }\n  } else if (s.includes(\",\")) {\n    const parts = s.split(\",\");\n    s = parts.length === 2 && parts[1].length !== 3\n      ? s.replace(\",\", \".\")\n      : s.replace(/,/g, \"\");\n  }\n\n  const n = Number(s);\n  return Number.isFinite(n) && n >= 0 ? n : null;\n}\n\n\nfunction extractEmails(text) {\n  return [...new Set(\n    (String(text || \"\").match(\n      /[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi\n    ) || []).map(x => x.trim().toLowerCase())\n  )];\n}\n\nfunction extractPhones(text) {\n  const found = [];\n\n  for (const line of String(text || \"\").split(/\\r?\\n/)) {\n    if (!/(телефон|тел\\.|мобильн|phone)/i.test(line)) continue;\n\n    const matches = line.match(/\\+?\\d[\\d\\s().-]{6,}\\d/g) || [];\n\n    for (const value of matches) {\n      const digits = value.replace(/\\D/g, \"\");\n      if (digits.length >= 10 && digits.length <= 15) {\n        found.push(value.replace(/\\s+/g, \" \").trim());\n      }\n    }\n  }\n\n  const unique = new Map();\n  for (const phone of found) {\n    const key = phone.replace(/\\D/g, \"\");\n    if (!unique.has(key)) unique.set(key, phone);\n  }\n\n  return [...unique.values()];\n}\n\nfunction extractInn(text) {\n  for (const line of String(text || \"\").split(/\\r?\\n/)) {\n    const rawLabel = (line.split(/[:：]/, 1)[0] || \"\")\n      .toUpperCase()\n      .replace(/[^A-ZА-ЯЁ]/g, \"\");\n\n    const label = rawLabel\n      .replace(/[UI]/g, \"И\")\n      .replace(/H/g, \"Н\");\n\n    if (!label.includes(\"ИНН\")) continue;\n\n    const candidates = line.match(/\\d[\\d\\s-]{8,16}\\d/g) || [];\n\n    for (const candidate of candidates) {\n      const digits = candidate.replace(/\\D/g, \"\");\n      if (digits.length === 10 || digits.length === 12) {\n        return digits;\n      }\n    }\n  }\n\n  return null;\n}\n\nconst records = [];\n\nfor (let i = 0; i < outputs.length; i++) {\n  let content = outputs[i].json?.message?.content;\n\n  if (typeof content !== \"string\") {\n    throw new Error(\"Нет message.content у Ollama, страница \" + (i + 1));\n  }\n\n  content = content.trim();\n\n  const fence = String.fromCharCode(96).repeat(3);\n\n  if (content.startsWith(fence)) {\n    content = content.replace(\n      new RegExp(\"^\" + fence + \"(?:json)?\\\\s*\", \"i\"), \"\"\n    );\n    content = content.replace(\n      new RegExp(\"\\\\s*\" + fence + \"$\"), \"\"\n    );\n  }\n\n  let parsed;\n\n  try {\n    parsed = JSON.parse(content);\n  } catch (e) {\n    throw new Error(\"Ошибка JSON Ollama на странице \" + (i + 1));\n  }\n\n  if (!Array.isArray(parsed.records)) {\n    throw new Error(\"Нет массива records на странице \" + (i + 1));\n  }\n\n  const page = pages[i].json;\n\n  for (let j = 0; j < parsed.records.length; j++) {\n    const r = parsed.records[j] || {};\n    const row = j + 1;\n\n    const warnings = Array.isArray(r.warnings)\n      ? r.warnings.map(String)\n      : [];\n\n    const emails = Array.isArray(r.emails)\n      ? r.emails.filter(Boolean)\n      : [];\n\n    const phones = Array.isArray(r.phones)\n      ? r.phones.filter(Boolean)\n      : [];\n\n    if (r.email) emails.push(r.email);\n    if (r.phone) phones.push(r.phone);\n\n    const pageText = String(page.page_text || \"\");\n    const ocrEmailCandidates = extractEmails(pageText);\n    const ocrPhoneCandidates = extractPhones(pageText);\n    const ocrInn = extractInn(pageText);\n\n    const modelEmailSet = new Set(\n      emails.map(x => String(x).trim().toLowerCase())\n    );\n\n    const unconfirmedEmails = ocrEmailCandidates.filter(\n      x => !modelEmailSet.has(x)\n    );\n\n    const modelPhoneSet = new Set(\n      phones.map(x => String(x).replace(/\\D/g, \"\"))\n    );\n\n    const unconfirmedPhones = ocrPhoneCandidates.filter(\n      x => !modelPhoneSet.has(x.replace(/\\D/g, \"\"))\n    );\n\n    if (unconfirmedEmails.length) {\n      warnings.push(\n        \"ocr_contains_unconfirmed_email_candidates:\" +\n        unconfirmedEmails.length\n      );\n    }\n\n    if (unconfirmedPhones.length) {\n      warnings.push(\n        \"ocr_contains_unconfirmed_phone_candidates:\" +\n        unconfirmedPhones.length\n      );\n    }\n\n    const modelInnDigits = r.inn\n      ? String(r.inn).replace(/\\D/g, \"\")\n      : \"\";\n\n    const validModelInn = [10, 12].includes(modelInnDigits.length)\n      ? modelInnDigits\n      : null;\n\n    const finalInn = validModelInn || (parsed.records.length === 1 ? ocrInn : null);\n\n    if (!validModelInn && finalInn) {\n      warnings.push(\"inn_recovered_from_ocr_labeled_line\");\n    }\n\n    if (r.city && /[A-Za-z]/.test(String(r.city))) {\n      warnings.push(\"city_contains_latin_characters_check_source_pdf\");\n    }\n\n    if (page.needs_review) {\n      warnings.push(\"ocr_page_requires_review\");\n    }\n\n    records.push({\n      ...r,\n      inn: finalInn,\n      email: r.email || emails[0] || null,\n      phone: r.phone || phones[0] || null,\n      emails: [...new Set(\n        emails.map(x => String(x).trim()).filter(Boolean)\n      )],\n      phones: [...new Set(\n        phones.map(x => String(x).trim()).filter(Boolean)\n      )],\n      revenue_rub: normalizeRevenue(r.revenue_rub),\n      source_page: page.source_page,\n      source_row: row,\n      source_row_model: r.source_row || null,\n      source_key: \"p\" + page.source_page + \"-r\" + row,\n      source_locator: (page.source_locator || \"page=\" + page.source_page) + \";record=\" + row,\n      extraction_warnings: [...new Set(warnings)]\n    });\n  }\n}\n\nif (!records.length) {\n  throw new Error(\"Ollama не обнаружил ни одной записи компаний или инвесторов\");\n}\n\nreturn [{ json: { records } }];\n"
        },
        "onError": "continueErrorOutput"
      },
