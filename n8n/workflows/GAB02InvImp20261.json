      {
        "id": "GAB2000000000010",
        "name": "Prepare PDF pages",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1980,
          100
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "\nconst root = $input.first()?.json || {};\n\nif (!root.ok || !Array.isArray(root.pages)) {\n  throw new Error(\"OCR не вернул корректный массив pages\");\n}\n\nconst batchId = $(\"Claim and normalize\").first().json.batch_id;\n\nconst schema = {\n  type: \"object\",\n  additionalProperties: false,\n  properties: {\n    records: {\n      type: \"array\",\n      items: {\n        type: \"object\",\n        additionalProperties: false,\n        properties: {\n          company_name: {type: [\"string\", \"null\"]},\n          inn: {type: [\"string\", \"null\"]},\n          city: {type: [\"string\", \"null\"]},\n          full_name: {type: [\"string\", \"null\"]},\n          position: {type: [\"string\", \"null\"]},\n          email: {type: [\"string\", \"null\"]},\n          phone: {type: [\"string\", \"null\"]},\n          emails: {type: \"array\", items: {type: \"string\"}},\n          phones: {type: \"array\", items: {type: \"string\"}},\n          revenue_rub: {type: [\"number\", \"null\"]},\n          revenue_year: {type: [\"integer\", \"null\"]},\n          source_row: {type: [\"integer\", \"null\"]},\n          warnings: {type: \"array\", items: {type: \"string\"}}\n        },\n        required: [\n          \"company_name\", \"inn\", \"city\", \"full_name\", \"position\",\n          \"email\", \"phone\", \"emails\", \"phones\", \"revenue_rub\",\n          \"revenue_year\", \"source_row\", \"warnings\"\n        ]\n      }\n    }\n  },\n  required: [\"records\"]\n};\n\nfor (const key of ['address','website','industry','general_phone','general_email','revenue_currency','revenue_source','financial_check_status','investor_type','comments']) {\n  schema.properties.records.items.properties[key] = {type: ['string', 'null']};\n}\nconst systemPrompt =\n  \"Ты извлекаешь сведения об инвесторах и компаниях из русскоязычных документов. \" +\n  \"Извлеки ВСЕ отдельные компании и контакты, которые явно указаны на странице. \" +\n  \"Не объединяй разные компании. Не выдумывай ИНН, телефоны, email, город или выручку. \" +\n  \"Сохраняй все найденные email и телефоны в массивах. \" +\n  \"ИНН — только 10 или 12 цифр, если он полностью читается. \" +\n  \"Выручку записывай числом в рублях только если сумма и единицы однозначны. \" +\n  \"При неоднозначности оставляй null и добавляй предупреждение. \" +\n  \"Не включай заголовки и рекламные фрагменты. Строго соблюдай JSON Schema.\";\n\nconst result = root.pages.map((p, i) => {\n  const page = {\n    batch_id: batchId,\n    source_page: Number(p.page) || i + 1,\n    page_text: String(p.raw_text || \"\"),\n    source_locator: p.source_locator || null,\n    needs_review: Boolean(p.needs_review),\n    ocr_error: p.ocr_error || null\n  };\n\n  return {\n    json: {\n      ...page,\n      ollama_request: {\n        model: \"qwen2.5:7b\",\n        stream: false,\n        format: schema,\n        options: {\n          temperature: 0,\n          num_ctx: 16384,\n          num_predict: 6000\n        },\n        messages: [\n          {role: \"system\", content: systemPrompt},\n          {\n            role: \"user\",\n            content:\n              \"Извлеки все записи инвесторов и компаний с этой страницы. \" +\n              \"Не объединяй разные контакты. Сохраняй порядок появления. \" +\n              \"Текст страницы с номером: \" +\n              String(page.source_page) + \"\\n\" + page.page_text\n          }\n        ]\n      }\n    }\n  };\n});\n\nif (!result.length) {\n  throw new Error(\"В PDF нет страниц\");\n}\n\nif (result.every(x => !x.json.page_text.trim())) {\n  throw new Error(\"OCR не извлёк текст ни с одной страницы\");\n}\n\nreturn result;\n"
        },
        "onError": "continueErrorOutput"
      },
